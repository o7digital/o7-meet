# Existing Meet / LiveKit settings stay in .env.staging.
APP_ORIGIN=https://meet-staging.o7digitalgroup.com
MEET_DATA_DIR=/data
MAIL_IMAP_HOST=mail.o7digitalgroup.com
MAIL_IMAP_PORT=993
# Populate exclusively from verified identities. No passwords are stored here.
MEET_IDENTITIES_JSON=[]
# Reuse the provider already configured in Olivia. Server only.
OPENAI_API_KEY=
OLIVIA_MEET_MODEL=gpt-4o
# Optional Microsoft professional-account connector (single organisation).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
